# This file is just a reference — copy to .env for local `vite dev` if needed.
# Real values live in the Cloudflare dashboard (Worker > Settings > Variables and Secrets).
# See setup.txt for the full walkthrough.

# --- Build-time (used by the frontend, must start with VITE_) ---
# A secret-ish URL path for your admin panel, e.g. "control-8x7q2z"
VITE_ADMIN_PATH=control-panel

# --- Runtime (used by the Worker / API, set as Cloudflare env vars or secrets) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
SESSION_SECRET=a-long-random-string
ADMIN_EMAILS=sreehariar2008@gmail.com,lofiscide@gmail.com
