{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This name becomes part of your live URL:
  // https://qenfc.<your-workers-dev-subdomain>.workers.dev
  "name": "qenfc",
  "main": "worker/index.js",
  // Keep this as roughly "today" when you first deploy — see setup.txt.
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
