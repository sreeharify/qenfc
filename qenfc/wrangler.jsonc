{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This name becomes part of your live URL:
  // https://qenfc.<your-workers-dev-subdomain>.workers.dev
  "name": "qenfc",
  "main": "worker/index.js",
  // Keep this as a fixed past date — it does not need to track "today".
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // By default, `wrangler deploy` WIPES every dashboard-set variable on each
  // deploy and replaces them with only what's listed here. That's why
  // ADMIN_EMAILS is defined directly in this file instead of the dashboard —
  // it isn't sensitive, so it's safe to commit, and this way it can never
  // "disappear" on a redeploy. Edit the list below to change who has admin
  // access, then commit + push.
  "vars": {
    "ADMIN_EMAILS": "sreehariar2008@gmail.com,lofiscide@gmail.com"
  },
  // Extra safety net: don't wipe any *other* variables you set via the
  // Cloudflare dashboard (DATABASE_URL, GOOGLE_CLIENT_ID, etc.) on deploy.
  "keep_vars":